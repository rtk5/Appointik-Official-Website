{
  "hosting": {
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "arogyavardhini/**",
      "shatayuphysio/**",
      "jayamclinic/**",
      "kdham-DrSanthosh/**",
      "drkphysioplusclinic/**",
      "specialties/**"
    ],
    "redirects": [
      {
        "source": "/demo",
        "destination": "https://book.appointik.in/c/appointik-team-clinic",
        "type": 301
      },
      {
        "source": "/demo/",
        "destination": "https://book.appointik.in/c/appointik-team-clinic",
        "type": 301
      },
      {
        "source": "/demotimeslot",
        "destination": "https://book.appointik.in/c/appointik-team-clinic",
        "type": 301
      },
      {
        "source": "/demotimeslot/",
        "destination": "https://book.appointik.in/c/appointik-team-clinic",
        "type": 301
      },
      {
        "source": "/demo/index.html",
        "destination": "https://book.appointik.in/c/appointik-team-clinic",
        "type": 301
      },
      {
        "source": "/demotimeslot/index.html",
        "destination": "https://book.appointik.in/c/appointik-team-clinic",
        "type": 301
      },
      {
        "source": "/demofree",
        "destination": "https://book.appointik.in/c/appointik-team-clinic",
        "type": 301
      },
      {
        "source": "/demofree/",
        "destination": "https://book.appointik.in/c/appointik-team-clinic",
        "type": 301
      },
      {
        "source": "/demofree/index.html",
        "destination": "https://book.appointik.in/c/appointik-team-clinic",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "trailingSlash": true
  }
}
