{
  "hosting": {
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/features",
        "destination": "/features/",
        "type": 301
      },
      {
        "source": "/pricing",
        "destination": "/pricing/",
        "type": 301
      },
      {
        "source": "/success-stories",
        "destination": "/success-stories/",
        "type": 301
      },
      {
        "source": "/support",
        "destination": "/support/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }
}
